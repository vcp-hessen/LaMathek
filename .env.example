# Flask
SECRET_KEY=change-me-in-production
SQLITE_PATH=server/lamathek.sqlite3

# OpenID Connect (Authentik or Keycloak)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
FRONTEND_URL=http://localhost:5173

# Local login without OIDC (development only; requires FLASK_DEBUG or AUTH_DEV_BYPASS_ALLOW)
FLASK_DEBUG=1
# AUTH_DEV_BYPASS=1
# AUTH_DEV_BYPASS_ALLOW=1
# AUTH_DEV_SUB=dev:local
# AUTH_DEV_NAME=Dev User
# AUTH_DEV_EMAIL=dev@example.com
# AUTH_DEV_SUPERUSER=1
