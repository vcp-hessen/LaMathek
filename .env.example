# Flask. Required outside FLASK_DEBUG: the app refuses to start with the built-in default.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Relative to the repository root, or an absolute path (Coolify: /data/lamathek.sqlite3)
SQLITE_PATH=server/lamathek.sqlite3
# Optional; overrides SQLITE_PATH with any SQLAlchemy URL
# DATABASE_URL=sqlite:////data/lamathek.sqlite3
# Optional; defaults to media/ beside the SQLite file
# MEDIA_PATH=server/media

# Dev server (`lamathek` / `lamathek serve`); the image uses gunicorn on PORT
# LAMATHEK_BIND_HOST=127.0.0.1
# LAMATHEK_API_PORT=5001
# PORT=5001
# LAMATHEK_RELOAD=0
# Built client served by Flask; defaults to web/dist in a checkout
# LAMATHEK_STATIC_ROOT=/app/web/dist

# OpenID Connect (Authentik or Keycloak)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
FRONTEND_URL=http://localhost:5173

# SMTP (optional; leave SMTP_HOST empty to disable outbound mail)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=1
# SMTP_SSL=0
# SMTP_TIMEOUT=15

# IANA timezone for PDF timestamps etc. (default: Europe/Berlin)
# LAMATHEK_INSTANCE_TIMEZONE=Europe/Berlin

# Dev login without OIDC (only with FLASK_DEBUG=1 or AUTH_DEV_BYPASS_ALLOW=1)
# AUTH_DEV_BYPASS=1
# AUTH_DEV_SUB=dev:local
# AUTH_DEV_NAME=Dev User
# AUTH_DEV_EMAIL=dev@local
# AUTH_DEV_SUPERUSER=1

# For local UI testing, use ./scripts/dev.sh: it loads .env.dev (tracked
# defaults), then .env.local (gitignored; your name, mail, SMTP credentials).
