# Local development defaults (used by ./scripts/dev.sh via LAMATHEK_ENV=dev).
# Copy values into .env if you run the API without the dev script.

SECRET_KEY=dev-only-not-for-production
SQLITE_PATH=server/lamathek.sqlite3
LAMATHEK_API_PORT=5001
WEB_PORT=5173

FRONTEND_URL=http://127.0.0.1:5173
OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback

FLASK_DEBUG=1
AUTH_DEV_BYPASS=1
AUTH_DEV_SUB=dev:local
AUTH_DEV_NAME='Dev User'
AUTH_DEV_EMAIL=dev@local
AUTH_DEV_SUPERUSER=1
